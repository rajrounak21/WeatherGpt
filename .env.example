# WeatherGPT Environment Variables
# Copy this file to .env -> `cp .env.example .env` and fill your keys
# Never commit real .env to GitHub

# 1. Groq LLM — for AI Weather Agent + Study Hub explain
# Get from https://console.groq.com/keys
# Used in: agent/graph.py, study_hub/router.py, services/stt/tts
GROQ_API_KEY=replace-with-our-groq-api-key

# 2. MongoDB — for Proactive Alert System only (persistent subscriptions + dedup)
# Atlas: https://cloud.mongodb.com -> Create cluster -> Connect -> MongoDB URI
# Used in: alerts/db.py, alerts/worker.py
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
# Optional DB name (default: weathergpt)
MONGODB_DB=weathergpt

# 3. Web Push VAPID — for Browser Notifications (Alerts)
# Generate once: `python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key)"` 
# Or: `npx web-push generate-vapid-keys`
# Public is sent to browser at /api/alerts/vapid-public-key, private stays server-only
VAPID_PUBLIC_KEY=BHFlLkPPaRLI_9gKkWj4SEAdYPs0c-o9pienOXSJ5Xv2YXN6GdiIYPrTzWBn3fMTf_mVEKTx34vp-D_Iwvj2iqw
VAPID_PRIVATE_KEY=ENYD858TScR1ML2aYS384rZ-RSvkMbO5E-0lMLpsgls
VAPID_SUBJECT=mailto:alerts@weathergpt.local

# 4. Alert Worker Polling (configurable, not hard-coded)
# How often worker checks IMD. Default 15 min. Tune after verifying IMD update frequency.
# Used in: alerts/worker.py POLL_MIN
ALERT_POLL_INTERVAL_MIN=15

# 5. Optional: Mock IMD for local demo without whitelisting
# When IMD District API returns 401 (IP not whitelisted), set to 1 to inject fake orange warning for subscribed districts
# Remove or set 0 for production after IP whitelisting is approved
# MOCK_ALERTS=1
